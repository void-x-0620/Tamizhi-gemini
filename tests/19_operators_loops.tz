# For loops, do-while, bitwise operators, compound assign, ++/--, ternary, if/else
seyal main() : int {
    # For loop and compound assign
    edu sum : int = 0;
    for (edu i : int = 1; i <= 5; i++) {
        sum += i;
    }
    pathi("sum 1..5 = %d\n", sum);

    # Do-while loop
    edu count : int = 0;
    do {
        count++;
    } while (count < 3);
    pathi("do-while count = %d\n", count);

    # Bitwise operators: &, |, ^, ~, <<, >>
    edu a : int = 12;   # 0b1100
    edu b : int = 10;   # 0b1010
    pathi("a & b = %d\n", a & b);   # 8  (0b1000)
    pathi("a | b = %d\n", a | b);   # 14 (0b1110)
    pathi("a ^ b = %d\n", a ^ b);   # 6  (0b0110)
    pathi("a << 1 = %d\n", a << 1); # 24
    pathi("a >> 1 = %d\n", a >> 1); # 6

    # Ternary operator
    edu max_val : int = (a > b) ? a : b;
    pathi("max(a, b) = %d\n", max_val);

    # C style if / else if / else
    edu score : int = 85;
    if (score >= 90) {
        pathi("Grade: A\n");
    } else if (score >= 80) {
        pathi("Grade: B\n");
    } else {
        pathi("Grade: C\n");
    }

    kudu 0;
}
