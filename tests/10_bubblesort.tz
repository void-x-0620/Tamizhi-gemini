# Bubble sort — arrays, loops, conditionals and functions together
seyal swap(arr : int[], i : int, j : int) {
    edu tmp : int = arr[i];
    arr[i] = arr[j];
    arr[j] = tmp;
}

seyal bubble_sort(arr : int[], n : int) {
    edu i : int = 0;
    sutri (i < n - 1) {
        edu j : int = 0;
        sutri (j < n - i - 1) {
            @(arr[j] > arr[j + 1]) aga irundha { swap(arr, j, j + 1); }
            j = j + 1;
        }
        i = i + 1;
    }
}

seyal print_array(arr : int[], n : int) {
    edu i : int = 0;
    sutri (i < n) {
        pathi("%d", arr[i]);
        @(i < n - 1) aga irundha { pathi(" "); }
        i = i + 1;
    }
    pathi("\n");
}

seyal main() : int {
    edu data : int[] = [64, 34, 25, 12, 22, 11, 90];
    pathi("Before: ");
    print_array(data, 7);
    bubble_sort(data, 7);
    pathi("After:  ");
    print_array(data, 7);
    kudu 0;
}
